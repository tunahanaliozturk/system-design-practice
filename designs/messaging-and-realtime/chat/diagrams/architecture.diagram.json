    { "id": "s3", "kind": "storage", "label": "S3 media bucket", "col": 0, "row": 2.8, "lines": ["encrypted blobs", "lifecycle to IA tier"] },
    { "id": "cdn", "kind": "cdn", "label": "CDN", "col": 1, "row": 2.8, "lines": ["signed URLs", "origin = S3"] },
    { "id": "api", "kind": "service", "label": "Sync and history API", "col": 2, "row": 2.8, "lines": ["conversation index", "messages after seq N", "pre-signs media PUT"] },
    { "id": "pg", "kind": "postgres", "label": "PostgreSQL (sharded)", "col": 2, "row": 4.1, "lines": ["users, devices", "conversations, members"] },
    { "id": "push", "kind": "worker", "label": "Push workers", "col": 3, "row": 4.1, "lines": ["collapse per conversation", "no message text in payload"] },
