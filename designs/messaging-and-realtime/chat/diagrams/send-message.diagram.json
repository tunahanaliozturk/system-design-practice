{
  "type": "sequence",
  "title": "Chat: the send path",
  "subtitle": "The sender gets its tick once Kafka has the record; recipients see it only after the store has it",
  "spacing": 220,
  "participants": [
    { "id": "a", "kind": "client", "label": "Sender device" },
    { "id": "gwa", "kind": "service", "tag": "STATEFUL", "label": "Gateway A" },
    { "id": "k", "kind": "queue", "label": "Kafka" },
    { "id": "m", "kind": "service", "label": "Message service" },
    { "id": "db", "kind": "nosql", "tag": "SCYLLADB", "label": "Message store" },
    { "id": "f", "kind": "worker", "label": "Fan-out" }
  ],
  "steps": [
    { "from": "a", "to": "gwa", "label": "SEND conv, `client_msg_id`, body" },
    { "from": "gwa", "to": "gwa", "label": "rate limit, member pre-check" },
    { "from": "gwa", "to": "k", "label": "produce `chat.inbound`, key = conv" },
    { "from": "k", "to": "gwa", "reply": true, "label": "acks=all: offset 48211" },
    { "from": "gwa", "to": "a", "reply": true, "label": "ACK seq 48211 (one tick)" },
    { "from": "k", "to": "m", "dashed": true, "label": "poll partition 1873" },
    { "from": "m", "to": "db", "label": "SELECT `client_msgs` (dedupe)" },
    { "from": "m", "to": "db", "label": "QUORUM writes, in seq order" },
    { "note": "`messages` row, `client_msgs` row,\n`conversation_heads`,\n`user_conversations` per member", "at": "db" },
    { "from": "m", "to": "k", "label": "produce `chat.persisted`" },
    { "from": "m", "to": "k", "label": "commit `chat.inbound` offset" },
    { "from": "k", "to": "f", "dashed": true, "label": "consume: deliver (next diagram)" }
  ]
}
