{
  "type": "sequence",
  "title": "Ride-hailing: request, offer, accept",
  "subtitle": "Redis decides which driver sees the offer; one conditional UPDATE in PostgreSQL decides who gets the trip",
  "spacing": 190,
  "participants": [
    { "id": "r", "kind": "client", "label": "Rider app" },
    { "id": "t", "kind": "service", "label": "Trip service" },
    { "id": "pg", "kind": "postgres", "label": "PostgreSQL" },
    { "id": "k", "kind": "queue", "label": "Kafka" },
    { "id": "d", "kind": "service", "label": "Dispatch" },
    { "id": "g", "kind": "service", "label": "Geo index" },
    { "id": "rd", "kind": "redis", "label": "Redis" },
    { "id": "drv", "kind": "client", "label": "Driver app" }
  ],
  "steps": [
    { "from": "r", "to": "t", "label": "POST /trips (quote_token) + `Idempotency-Key`" },
    { "note": "verify quote signature, expiry, rider_id\nBEGIN; INSERT trips (REQUESTED); INSERT outbox trip.requested; COMMIT\nunique (rider_id, idempotency_key) turns a retry into the same trip", "over": ["t", "pg"] },
    { "from": "t", "to": "r", "reply": true, "label": "202 { trip_id, REQUESTED }" },
    { "from": "pg", "to": "k", "dashed": true, "label": "CDC: trip.requested" },
    { "from": "k", "to": "d", "dashed": true, "label": "trip.requested (key trip_id)" },
    { "from": "d", "to": "g", "label": "AVAILABLE in kRing(cell, 2), widen 4, 7" },
    { "from": "g", "to": "d", "reply": true, "label": "14 candidates" },
    { "from": "d", "to": "d", "label": "road ETA matrix, keep top 5" },
    { "section": "loop: next candidate until one accepts (about 60 s budget)" },
    { "from": "d", "to": "rd", "label": "SET `drv:lock:{driver}` trip_id NX EX 15" },
    { "from": "rd", "to": "d", "reply": true, "label": "OK  (nil: skip this driver)" },
    { "from": "d", "to": "pg", "label": "SET offer_driver_id, offer_expires_at = now() + 12 s" },
    { "from": "d", "to": "rd", "label": "PUBLISH `driver:{id}` offer" },
    { "from": "rd", "to": "drv", "dashed": true, "label": "offer via driver gateway socket" },
    { "section": "alt: driver accepts within 12 s" },
    { "from": "drv", "to": "t", "label": "POST /driver/trips/{id}/accept" },
    { "note": "BEGIN\nUPDATE trips SET status = MATCHED, driver_id = $me WHERE id = $t AND status = REQUESTED\n    AND offer_driver_id = $me AND offer_expires_at > now()\nunique index trips_one_active_per_driver backs it up; INSERT outbox trip.matched\nCOMMIT", "over": ["t", "pg"] },
    { "from": "t", "to": "drv", "reply": true, "label": "200 MATCHED  (0 rows: 409 OFFER_EXPIRED)" },
    { "from": "pg", "to": "k", "dashed": true, "label": "trip.matched: Notifier tells rider" },
    { "section": "alt: driver declines or 12 s pass" },
    { "from": "d", "to": "rd", "label": "DEL lock if value = trip_id, SADD `dispatch:{trip}:tried`" },
    { "from": "d", "to": "d", "label": "next candidate" }
  ]
}
