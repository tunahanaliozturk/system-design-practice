{
  "type": "sequence",
  "title": "Ride-hailing: request, offer, accept",
  "subtitle": "Redis decides which driver sees the offer; one conditional UPDATE in PostgreSQL decides who gets the trip",
  "spacing": 220,
  "participants": [
    { "id": "r", "kind": "client", "label": "Rider app" },
    { "id": "t", "kind": "service", "label": "Trip service" },
    { "id": "pg", "kind": "postgres", "label": "PostgreSQL" },
    { "id": "d", "kind": "service", "label": "Dispatch" },
    { "id": "rd", "kind": "redis", "label": "Redis" },
    { "id": "drv", "kind": "client", "label": "Driver app" }
  ],
  "steps": [
    { "from": "r", "to": "t", "label": "POST /trips (quote_token) + `Idempotency-Key`" },
    { "note": "verify quote: signature, expiry, rider_id\nBEGIN; INSERT trips (REQUESTED) + outbox; COMMIT\nUNIQUE (rider_id, idempotency_key): a retry is the same trip", "over": ["t", "pg"] },
    { "from": "t", "to": "r", "reply": true, "label": "202 { trip_id, REQUESTED }" },
    { "from": "pg", "to": "d", "dashed": true, "label": "CDC: trip.requested" },
    { "from": "d", "to": "d", "label": "geo index: kRing(cell, 2), widen to 4, 7" },
    { "from": "d", "to": "d", "label": "routing ETA matrix, rank, keep top 5" },
    { "section": "loop: next candidate until one accepts (60 s budget)" },
    { "from": "d", "to": "rd", "label": "SET `drv:lock:{driver}` trip_id NX EX 15" },
    { "from": "rd", "to": "d", "reply": true, "label": "OK  (nil: skip this driver)" },
    { "from": "d", "to": "pg", "label": "SET offer_driver_id, offer_expires_at = now() + 12 s" },
    { "from": "d", "to": "rd", "label": "PUBLISH `driver:{id}`" },
    { "from": "rd", "to": "drv", "dashed": true, "label": "offer via driver gateway" },
    { "section": "alt: driver accepts within 12 s" },
    { "from": "drv", "to": "t", "label": "POST /driver/trips/{id}/accept" },
    { "note": "BEGIN\nUPDATE trips SET status = MATCHED, driver_id = $me\nWHERE status = REQUESTED AND offer_driver_id = $me\nAND offer_expires_at > now()\nINSERT outbox trip.matched; COMMIT", "over": ["t", "pg"] },
    { "from": "t", "to": "drv", "reply": true, "label": "200 MATCHED  (0 rows: 409 OFFER_EXPIRED)" },
    { "from": "pg", "to": "r", "dashed": true, "label": "trip.matched via Notifier" },
    { "section": "alt: driver declines or 12 s pass" },
    { "from": "d", "to": "rd", "label": "DEL lock if ours; SADD `dispatch:{trip}:tried`" },
    { "from": "d", "to": "d", "label": "next candidate; at 60 s CANCELLED (NO_DRIVERS)" }
  ]
}
