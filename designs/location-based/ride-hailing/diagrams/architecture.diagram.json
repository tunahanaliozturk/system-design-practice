{
  "type": "architecture",
  "title": "Ride-hailing: high-level architecture",
  "subtitle": "Locations flow through Kafka into memory and never touch PostgreSQL; trips live in PostgreSQL and change by conditional UPDATE",
  "nodes": [
    { "id": "driver", "kind": "client", "label": "Driver app", "col": 0, "row": 0, "lines": ["GPS every 4 s", "accept, start, complete"] },
    { "id": "rider", "kind": "client", "label": "Rider app", "col": 0, "row": 3, "lines": ["estimate, request", "live map of the car"] },
    { "id": "dgw", "kind": "gateway", "label": "Driver gateway", "col": 1, "row": 0, "lines": ["WebSocket, ~100 nodes", "GPS in, offers out"] },
    { "id": "apigw", "kind": "gateway", "label": "API gateway", "col": 1, "row": 3, "lines": ["REST + rider WebSocket", "auth, rate limit"] },
    { "id": "kloc", "kind": "queue", "label": "Location stream", "col": 2, "row": 0, "lines": ["`locations.{region}`", "1.25M msg/s, 6 h"] },
    { "id": "s3", "kind": "storage", "label": "Location history", "col": 3, "row": 0, "lines": ["Parquet by day, city", "disputes, ETA models"] },
    { "id": "redis", "kind": "redis", "label": "Redis Cluster", "col": 1, "row": 1, "lines": ["`drv:lock:*` `surge:*`", "pub/sub `driver:*` `trip:*`", "`trip:path:*`"] },
    { "id": "surge", "kind": "worker", "tag": "FLINK", "label": "Surge job", "col": 2, "row": 1, "lines": ["supply, demand per cell", "every 30 s"] },
    { "id": "geo", "kind": "service", "label": "Geo index", "col": 3, "row": 1, "lines": ["in memory, per region", "H3 cell to drivers"] },
    { "id": "routing", "kind": "service", "label": "Routing / ETA", "col": 4, "row": 1, "lines": ["road graph + traffic", "one-to-many ETA"] },
    { "id": "pricing", "kind": "service", "label": "Pricing service", "col": 2, "row": 2, "lines": ["route + surge", "signed quote, 5 min"] },
    { "id": "dispatch", "kind": "service", "label": "Dispatch service", "col": 3, "row": 2, "lines": ["ring search, rank by ETA", "one offer at a time"] },
    { "id": "trip", "kind": "service", "label": "Trip service", "col": 2, "row": 3, "lines": ["state machine", "conditional updates"] },
    { "id": "pg", "kind": "postgres", "label": "PostgreSQL", "col": 3, "row": 3, "lines": ["trips, payments, outbox", "sharded by region", "source of truth"] },
    { "id": "kev", "kind": "queue", "label": "Kafka", "col": 4, "row": 3, "lines": ["`trip.events`", "`pricing.quotes`"] },
    { "id": "notify", "kind": "service", "label": "Notifier", "col": 5, "row": 3, "lines": ["PUBLISH `rider:{id}`", "APNs, FCM"] },
    { "id": "payment", "kind": "service", "label": "Payment service", "col": 3, "row": 4, "lines": ["auth at request", "capture at completion"] },
    { "id": "psp", "kind": "external", "label": "Payment provider", "col": 2, "row": 4, "lines": ["key = trip id"] }
  ],
