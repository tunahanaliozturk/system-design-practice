{
  "type": "sequence",
  "title": "Ride-hailing: fare estimate",
  "subtitle": "The quote is a signed token, not a row: nothing is stored, the price holds for 5 minutes",
  "spacing": 215,
  "participants": [
    { "id": "r", "kind": "client", "label": "Rider app" },
    { "id": "p", "kind": "service", "label": "Pricing" },
    { "id": "rt", "kind": "service", "label": "Routing / ETA" },
    { "id": "rd", "kind": "redis", "label": "Redis" },
    { "id": "g", "kind": "service", "label": "Geo index" },
    { "id": "k", "kind": "queue", "label": "Kafka" }
  ],
  "steps": [
    { "from": "r", "to": "p", "label": "POST /fare-estimates (pickup, dropoff, type)" },
    { "from": "p", "to": "rt", "label": "route pickup to dropoff" },
    { "from": "rt", "to": "p", "reply": true, "label": "8.1 km, 19 min" },
    { "from": "p", "to": "rd", "label": "GET `surge:{res-7 cell}`" },
    { "from": "rd", "to": "p", "reply": true, "label": "1.3  (missing key: 1.0)" },
    { "from": "p", "to": "g", "label": "nearest available drivers to pickup" },
    { "from": "g", "to": "p", "reply": true, "label": "6 drivers" },
    { "from": "p", "to": "rt", "label": "ETA from those drivers to pickup" },
    { "from": "rt", "to": "p", "reply": true, "label": "best pickup ETA 240 s" },
    { "note": "fare = rate card (distance, duration) x surge\ntoken = HMAC(quote_id, rider_id, route, fare, surge,\nexpires_at = now + 5 min, key_id)", "over": ["p", "rt"] },
    { "from": "p", "to": "k", "dashed": true, "label": "`pricing.quotes` (key rider_id)" },
    { "from": "p", "to": "r", "reply": true, "label": "200 { quote_token, fare, surge, ETA }" }
  ]
}
