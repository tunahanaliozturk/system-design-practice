{
  "type": "sequence",
  "title": "URL shortener: the redirect path",
  "subtitle": "Memory, Redis, replica, then the primary only for codes that could exist; the click event never blocks the 302",
  "spacing": 220,
  "participants": [
    { "id": "cdn", "kind": "cdn", "label": "CDN edge" },
    { "id": "rd", "kind": "service", "label": "Redirect service" },
    { "id": "r", "kind": "redis", "label": "Redis (region)" },
    { "id": "rep", "kind": "postgres", "label": "PG replica" },
    { "id": "pg", "kind": "postgres", "label": "PG primary" },
    { "id": "k", "kind": "queue", "label": "Kafka (region)" }
  ],
  "steps": [
    { "from": "cdn", "to": "rd", "label": "GET /aB3xK9p + country header" },
    { "note": "in-process LRU, 10 s TTL\nhit (about 60%): answer now, then step 5\nmiss: singleflight, one lookup per pod", "at": "rd" },
    { "from": "rd", "to": "r", "label": "GET `l:aB3xK9p`" },
    { "from": "r", "to": "rd", "reply": true, "label": "nil (cache miss)" },
    { "from": "rd", "to": "rep", "label": "SELECT ... WHERE code = $1" },
    { "from": "rep", "to": "rd", "reply": true, "label": "long_url, type, status, expires_at" },
    { "from": "rd", "to": "r", "label": "SET `l:aB3xK9p` EX min(86400, until expiry)" },
    { "note": "active and not expired: 302\nexpired or disabled: 410\nblocked: warning page", "at": "rd" },
    { "from": "rd", "to": "cdn", "reply": true, "label": "302 Location, `private, max-age=0`" },
    { "from": "rd", "to": "k", "dashed": true, "label": "click event, after the response" },
    { "section": "alt: replica has no row" },
    { "note": "decode the code to an id\nabove `ids:hwm`: 404 now, skip step 6", "over": ["rd", "r"] },
    { "from": "rd", "to": "pg", "label": "SELECT on primary (younger than replica lag)" },
    { "from": "pg", "to": "rd", "reply": true, "label": "no row" },
    { "from": "rd", "to": "r", "label": "SET `l404:aB3xK9p` EX 300" },
    { "from": "rd", "to": "cdn", "reply": true, "label": "404, `public, s-maxage=60`" }
  ]
}
