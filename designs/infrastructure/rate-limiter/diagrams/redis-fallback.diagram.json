{
  "type": "sequence",
  "title": "Rate limiter: when a Redis shard is slow or down",
  "subtitle": "One breaker per shard; while it is open each rule falls back to its own on_failure mode",
  "spacing": 230,
  "participants": [
    { "id": "c", "kind": "client", "label": "API client" },
    { "id": "gw", "kind": "gateway", "label": "Gateway + limiter" },
    { "id": "br", "kind": "service", "tag": "STATE", "label": "Breaker, shard 7" },
    { "id": "r", "kind": "redis", "label": "Redis shard 7" }
  ],
  "steps": [
    { "from": "c", "to": "gw", "label": "request for `ak_42`" },
    { "from": "gw", "to": "br", "label": "shard 7 usable?" },
    { "from": "br", "to": "gw", "reply": true, "label": "closed" },
    { "from": "gw", "to": "r", "label": "take `{k:42}:r23` want=20" },
    { "note": "no answer within 5 ms", "at": "r" },
    { "from": "gw", "to": "br", "label": "timeout (61% failed in last 1 s)" },
    { "from": "br", "to": "br", "label": "open for 2 s" },
    { "from": "gw", "to": "gw", "label": "decide by the rule's on_failure" },
    { "note": "local: bucket at rate / N, burst / N\nopen: allow and log\nclosed: 503 + Retry-After", "at": "gw" },
    { "from": "gw", "to": "c", "label": "200 or 429 (local), 503 (closed)" },
    { "section": "while open: no 5 ms wait" },
    { "from": "c", "to": "gw", "label": "request for `ak_42`" },
    { "from": "gw", "to": "br", "label": "shard 7 usable?" },
    { "from": "br", "to": "gw", "reply": true, "label": "open: skip Redis" },
    { "from": "gw", "to": "c", "label": "decision from on_failure" },
    { "section": "after 2 s: half-open" },
    { "from": "br", "to": "r", "label": "probe take" },
    { "from": "r", "to": "br", "reply": true, "label": "ok in 1 ms" },
    { "from": "br", "to": "br", "label": "close; leases come from Redis again" }
  ]
}
