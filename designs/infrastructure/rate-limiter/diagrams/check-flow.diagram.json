{
  "type": "sequence",
  "title": "Rate limiter: the hot path on one gateway node",
  "subtitle": "Most requests spend a locally leased token; Redis is called only to refill a lease, and a dead Redis falls back to a local bucket",
  "spacing": 250,
  "participants": [
    { "id": "c", "kind": "client", "label": "API client" },
    { "id": "gw", "kind": "gateway", "label": "Gateway + limiter" },
    { "id": "r", "kind": "redis", "label": "Redis shard" },
    { "id": "up", "kind": "service", "label": "Upstream API" },
    { "id": "k", "kind": "queue", "label": "Kafka" }
  ],
  "steps": [
    { "from": "c", "to": "gw", "label": "GET /v1/orders, key `ak_42`" },
    { "note": "auth -> plan pro; matching rules from local cache:\nr17 per key 5,000/s burst 10,000 (lease has 37 tokens left)\nr23 per key + endpoint 1,000/s burst 2,000 (lease empty)\nquota block list: `ak_42` not blocked", "at": "gw" },
    { "from": "gw", "to": "gw", "label": "r17: spend a leased token" },
    { "from": "gw", "to": "r", "label": "take `{k:42}:r23` want=20" },
    { "from": "r", "to": "gw", "reply": true, "label": "granted 20, left 311" },
    { "from": "gw", "to": "up", "label": "forward request" },
    { "from": "up", "to": "gw", "reply": true, "label": "200" },
    { "from": "gw", "to": "c", "reply": true, "label": "200 + `RateLimit` headers" },
    { "from": "gw", "to": "k", "dashed": true, "label": "usage delta for `ak_42` (every 10 s)" },
    { "section": "alt: bucket empty" },
    { "from": "gw", "to": "r", "label": "take `{k:42}:r23` want=20" },
    { "from": "r", "to": "gw", "reply": true, "label": "granted 0, retry_ms 180" },
    { "note": "deny cache: r23 for `ak_42` denied until now + 180 ms\nfurther requests on this node get 429 without calling Redis", "at": "gw" },
    { "from": "gw", "to": "c", "reply": true, "label": "429, `Retry-After: 1`" },
    { "section": "alt: Redis timeout (5 ms) or breaker open" },
    { "from": "gw", "to": "gw", "label": "local bucket, rate / 50" },
    { "from": "gw", "to": "up", "label": "forward if the local bucket allows" },
    { "from": "gw", "to": "c", "reply": true, "label": "200 or 429 from the local decision" }
  ]
}
