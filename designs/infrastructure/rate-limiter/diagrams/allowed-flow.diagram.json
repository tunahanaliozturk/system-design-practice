{
  "type": "sequence",
  "title": "Rate limiter: an allowed request",
  "subtitle": "One rule is decided from a leased token, the other refills its lease from Redis; nothing else leaves the node",
  "spacing": 220,
  "participants": [
    { "id": "c", "kind": "client", "label": "API client" },
    { "id": "gw", "kind": "gateway", "label": "Gateway + limiter" },
    { "id": "r", "kind": "redis", "label": "Redis shard" },
    { "id": "up", "kind": "service", "label": "Upstream API" },
    { "id": "k", "kind": "queue", "label": "Kafka" }
  ],
  "steps": [
    { "from": "c", "to": "gw", "label": "GET /v1/orders, key `ak_42`" },
    { "note": "auth: plan pro. Rules from the local index:\nr17 per key 5,000/s, burst 10,000\nr23 per key + route 1,000/s, burst 2,000", "at": "gw" },
    { "from": "gw", "to": "gw", "label": "block list, deny cache: clear" },
    { "from": "gw", "to": "gw", "label": "r17: spend 1 leased token" },
    { "from": "gw", "to": "r", "label": "r23 lease empty: take `{k:42}:r23` 20" },
    { "from": "r", "to": "gw", "reply": true, "label": "granted 20, left 311" },
    { "from": "gw", "to": "up", "label": "forward request" },
    { "from": "up", "to": "gw", "reply": true, "label": "200" },
    { "from": "gw", "to": "c", "label": "200 + `RateLimit` headers" },
    { "from": "gw", "to": "k", "dashed": true, "label": "usage for `ak_42`, every 10 s" }
  ]
}
