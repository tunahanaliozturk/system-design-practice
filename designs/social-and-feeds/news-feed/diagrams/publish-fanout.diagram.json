{
  "type": "sequence",
  "title": "News feed: fan-out after a post",
  "subtitle": "Async, idempotent, and skipped entirely for celebrities and inactive followers",
  "spacing": 225,
  "participants": [
    { "id": "pg", "kind": "postgres", "label": "PostgreSQL shard" },
    { "id": "k", "kind": "queue", "label": "Kafka" },
    { "id": "fr", "kind": "worker", "label": "Fan-out router" },
    { "id": "fw", "kind": "worker", "label": "Fan-out worker" },
    { "id": "r", "kind": "redis", "label": "Redis" }
  ],
  "steps": [
    { "from": "pg", "to": "k", "dashed": true, "label": "CDC: PostCreated, key author_id" },
    { "from": "k", "to": "fr", "dashed": true, "label": "post.events" },
    { "from": "fr", "to": "r", "label": "ZADD `ap:{author}`, trim to 100" },
    { "section": "alt: normal author (under 1M followers)" },
    { "from": "fr", "to": "pg", "label": "followers page: LIMIT 1000 (keyset)" },
    { "from": "fr", "to": "k", "dashed": true, "label": "fanout.jobs: post + 1,000 ids" },
    { "from": "k", "to": "fw", "dashed": true, "label": "job" },
    { "from": "fw", "to": "fw", "label": "drop ids not in active bitmap" },
    { "from": "fw", "to": "r", "label": "pipelined EVALSHA add_if_exists" },
    { "note": "per follower: if EXISTS `tl:{u}`\nZADD, then ZREMRANGEBYRANK 0 -801\nmissing key = inactive, nothing written", "over": ["fw", "r"] },
    { "from": "fw", "to": "k", "dashed": true, "label": "commit offset" },
    { "section": "alt: celebrity (1M+ followers)" },
    { "note": "no fan-out: step 3 is the only write\nTimeline nodes read post.events into RAM", "over": ["k", "fr"] }
  ]
}
